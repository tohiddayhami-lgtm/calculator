rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists(appId, userId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/userProfiles/$(userId));
    }

    function profile(appId, userId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/userProfiles/$(userId)).data;
    }

    function isConfiguredMasterEmail() {
      return signedIn()
             && request.auth.token.email == 'tohid.dayhami@gmail.com';
    }

    function isMaster(appId) {
      return signedIn()
             && (
               request.auth.token.admin == true
               || request.auth.token.master == true
               || isConfiguredMasterEmail()
               || (
                 profileExists(appId, request.auth.uid)
                 && profile(appId, request.auth.uid).role == 'master'
               )
             );
    }

    function hasActiveSubscription(appId, userId) {
      return !profileExists(appId, userId)
             || (
               profile(appId, userId).status == 'active'
               && profile(appId, userId).disabled != true
               && (
                 !profile(appId, userId).keys().hasAny(['subscriptionEndsAt'])
                 || profile(appId, userId).subscriptionEndsAt == null
                 || profile(appId, userId).subscriptionEndsAt > request.time.toMillis()
               )
             );
    }

    function canAccessUserData(appId, userId) {
      return signedIn()
             && (
               (request.auth.uid == userId && hasActiveSubscription(appId, userId))
               || isMaster(appId)
             );
    }

    // Commercial user registry: master can manage all users; users can read/bootstrap their own profile.
    match /artifacts/{appId}/userProfiles/{profileUserId} {
      allow read: if signedIn() && (request.auth.uid == profileUserId || isMaster(appId));
      allow create: if signedIn()
                    && (
                      isMaster(appId)
                      || (
                        request.auth.uid == profileUserId
                        && request.resource.data.uid == profileUserId
                        && request.resource.data.email == request.auth.token.email
                        && (
                          request.resource.data.role == 'user'
                          || (
                            request.resource.data.role == 'master'
                            && isConfiguredMasterEmail()
                          )
                        )
                      )
                    );
      allow update: if signedIn()
                    && (
                      isMaster(appId)
                      || (
                        request.auth.uid == profileUserId
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.disabled == resource.data.disabled
                        && request.resource.data.permissions == resource.data.permissions
                        && request.resource.data.subscriptionEndsAt == resource.data.subscriptionEndsAt
                      )
                    );
      allow delete: if isMaster(appId) && request.auth.uid != profileUserId;
    }

    // Each user can only read/write their own projects
    match /artifacts/{appId}/users/{userId}/projects/{projectId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // Saved HTML catalog share-link metadata (owner only)
    match /artifacts/{appId}/users/{userId}/catalogLinks/{linkId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // Public short-link lookup: anyone with the code can read the long Storage URL (then browser redirects).
    // Create/delete only by the owning user (ownerUserId must match auth uid).
    match /catalog_short_links/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['url', 'ownerUserId', 'storagePath', 'createdAt'])
                    && (
                      request.resource.data.ownerUserId == request.auth.uid
                      || (
                        request.resource.data.keys().hasAny(['appId'])
                        && isMaster(request.resource.data.appId)
                      )
                    )
                    && request.resource.data.url is string
                    && request.resource.data.storagePath is string
                    && request.resource.data.url.size() < 4000
                    && request.resource.data.storagePath.size() < 500
                    && code.size() >= 8
                    && code.size() <= 16;
      allow delete: if request.auth != null
                    && (
                      resource.data.ownerUserId == request.auth.uid
                      || isConfiguredMasterEmail()
                      || (
                        resource.data.keys().hasAny(['appId'])
                        && isMaster(resource.data.appId)
                      )
                    );
      allow update: if request.auth != null
                    && (
                      resource.data.ownerUserId == request.auth.uid
                      || isConfiguredMasterEmail()
                      || (
                        resource.data.keys().hasAny(['appId'])
                        && isMaster(resource.data.appId)
                      )
                    )
                    && request.resource.data.keys().hasAll(['url', 'ownerUserId', 'storagePath'])
                    && request.resource.data.ownerUserId == resource.data.ownerUserId
                    && request.resource.data.url is string
                    && request.resource.data.storagePath is string
                    && request.resource.data.url.size() < 4000
                    && request.resource.data.storagePath.size() < 500
                    && code.size() >= 8
                    && code.size() <= 16;
    }

    // Saved seller / business profiles — owner only
    match /artifacts/{appId}/users/{userId}/sellerProfiles/{profileId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // Archived (issued) invoices + their payments — owner only
    match /artifacts/{appId}/users/{userId}/invoiceArchive/{invoiceId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // Customer inquiries (from the public HTML catalog)
    match /artifacts/{appId}/users/{userId}/inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAny(['customer', 'items'])
                    && request.resource.data.size() < 30
                    && request.resource.data.get('items', []) is list
                    && request.resource.data.get('items', []).size() < 200;
      allow read, update, delete: if canAccessUserData(appId, userId);
    }

    // Full online exhibition booth reservation requests — public can submit; owner/master reviews.
    match /artifacts/{appId}/users/{userId}/exhibitionReservationRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
                      'eventId',
                      'appId',
                      'ownerUserId',
                      'categoryId',
                      'boothNumber',
                      'boothCode',
                      'companyName',
                      'contactName',
                      'phone',
                      'activityType',
                      'products',
                      'publicKey',
                      'publicReservationId',
                      'reviewStatus',
                      'createdAt'
                    ])
                    && request.resource.data.eventId is string
                    && request.resource.data.appId is string
                    && request.resource.data.ownerUserId is string
                    && request.resource.data.categoryId is string
                    && request.resource.data.boothNumber is number
                    && request.resource.data.boothCode is string
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() > 0
                    && request.resource.data.companyName.size() < 140
                    && request.resource.data.contactName is string
                    && request.resource.data.contactName.size() > 0
                    && request.resource.data.contactName.size() < 140
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.phone.size() < 100
                    && request.resource.data.activityType is string
                    && request.resource.data.activityType.size() > 0
                    && request.resource.data.activityType.size() < 180
                    && request.resource.data.products is string
                    && request.resource.data.products.size() > 0
                    && request.resource.data.products.size() < 1200
                    && request.resource.data.reviewStatus == 'new';
      allow read, update, delete: if canAccessUserData(appId, userId);
    }

    // Sanitized public reservation labels shown on public exhibition links.
    match /publicExhibitionReservations/{publicKey}/items/{reservationId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
                      'eventId',
                      'categoryId',
                      'boothNumber',
                      'boothCode',
                      'companyName',
                      'status',
                      'createdAt'
                    ])
                    && request.resource.data.eventId is string
                    && request.resource.data.categoryId is string
                    && request.resource.data.boothNumber is number
                    && request.resource.data.boothCode is string
                    && request.resource.data.companyName is string
                    && request.resource.data.companyName.size() > 0
                    && request.resource.data.companyName.size() < 140
                    && request.resource.data.status == 'reserved'
                    && publicKey.size() > 5
                    && publicKey.size() < 180;
      allow update, delete: if request.auth != null
                            && (
                              resource.data.ownerUserId == request.auth.uid
                              || isMaster(resource.data.appId)
                            );
    }

    // Community posts — all authenticated users can read; owner creates/deletes; no edits by others
    match /artifacts/{appId}/communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.keys().hasAll(['title', 'authorId', 'authorEmail', 'category', 'createdAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 300;
      allow delete: if request.auth != null
                    && (resource.data.authorId == request.auth.uid || isMaster(appId));
      allow update: if request.auth != null
                    && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.authorEmail == resource.data.authorEmail
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.keys().hasAll(['title', 'body', 'category', 'attachments', 'authorId', 'authorEmail', 'createdAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 300;
    }

    // Custom forms (per user) — owner read/write
    match /artifacts/{appId}/users/{userId}/forms/{formId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // ISO / quality management documents — owner or master
    match /artifacts/{appId}/users/{userId}/isoDocuments/{docId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // MetaPort metaverse booths — owner or master
    match /artifacts/{appId}/users/{userId}/metaBooths/{boothId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // ISO execution records — public links can submit; owner/master can review/manage
    match /artifacts/{appId}/users/{userId}/isoRecords/{recordId} {
      allow create: if request.resource.data.keys().hasAll(['isoDocId', 'docTitle', 'docNo', 'revision', 'submittedAt', 'submittedByName', 'checklistAnswers'])
                    && request.resource.data.submittedByName is string
                    && request.resource.data.submittedByName.size() > 0
                    && request.resource.data.submittedByName.size() < 200
                    && request.resource.data.checklistAnswers is list
                    && request.resource.data.checklistAnswers.size() < 100;
      allow read, update, delete: if canAccessUserData(appId, userId);
    }

    // Form submissions — anyone can create (public submit); owner reads/manages
    match /artifacts/{appId}/users/{userId}/formSubmissions/{subId} {
      allow create: if request.resource.data.keys().hasAll(['formKey', 'formName', 'submittedAt', 'data', 'isRead'])
                    && request.resource.data.data is map
                    && request.resource.data.data.size() < 100;
      allow read, update, delete: if canAccessUserData(appId, userId);
    }

    // Public form definitions — anyone can read; owner creates/updates/deletes
    match /publicForms/{key} {
      allow read: if true;
      allow create: if request.auth != null
                    && (
                      request.resource.data.ownerUid == request.auth.uid
                      || isMaster(request.resource.data.appId)
                    )
                    && request.resource.data.keys().hasAll(['ownerUid', 'appId', 'name', 'fields', 'isActive'])
                    && request.resource.data.fields is list
                    && request.resource.data.fields.size() < 100;
      allow update, delete: if request.auth != null
                            && (
                              resource.data.ownerUid == request.auth.uid
                              || isMaster(resource.data.appId)
                            );
    }

    // Published ISO documents — public link read; owner/master publish and manage
    match /publicIsoDocuments/{key} {
      allow read: if true;
      allow create: if request.auth != null
                    && (
                      request.resource.data.ownerUid == request.auth.uid
                      || isMaster(request.resource.data.appId)
                    )
                    && request.resource.data.keys().hasAll(['ownerUid', 'appId', 'title', 'docNo', 'revision', 'kind', 'isActive']);
      allow update, delete: if request.auth != null
                            && (
                              resource.data.ownerUid == request.auth.uid
                              || isMaster(resource.data.appId)
                            );
    }

    // Heavy public form assets — loaded after the text definition so forms open faster.
    match /publicFormAssets/{key} {
      allow read: if true;
      allow create: if request.auth != null
                    && (
                      request.resource.data.ownerUid == request.auth.uid
                      || isMaster(request.resource.data.appId)
                    )
                    && request.resource.data.keys().hasAll(['ownerUid', 'appId']);
      allow update, delete: if request.auth != null
                            && (
                              resource.data.ownerUid == request.auth.uid
                              || isMaster(resource.data.appId)
                            );
    }

    // Meta Trading Hub saved link metadata (owner only)
    match /artifacts/{appId}/users/{userId}/metaHubLinks/{linkId} {
      allow read, write: if canAccessUserData(appId, userId);
    }

    // Meta Trading Hub public short-link lookup (same rules as catalog_short_links)
    match /meta_hub_links/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['url', 'ownerUserId', 'storagePath', 'createdAt'])
                    && (
                      request.resource.data.ownerUserId == request.auth.uid
                      || (
                        request.resource.data.keys().hasAny(['appId'])
                        && isMaster(request.resource.data.appId)
                      )
                    )
                    && request.resource.data.url is string
                    && request.resource.data.storagePath is string
                    && request.resource.data.url.size() < 4000
                    && request.resource.data.storagePath.size() < 500
                    && code.size() >= 8
                    && code.size() <= 16;
      allow delete: if request.auth != null
                    && (
                      resource.data.ownerUserId == request.auth.uid
                      || (
                        resource.data.keys().hasAny(['appId'])
                        && isMaster(resource.data.appId)
                      )
                    );
      allow update: if false;
    }

    // Catalog analytics — summary doc created by the app owner; events written by public catalog visitors
    match /catalog_analytics/{shortCode} {
      allow read: if request.auth != null
                  && (resource.data.ownerUserId == request.auth.uid || isConfiguredMasterEmail());
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['ownerUserId', 'appId', 'shortCode', 'createdAt'])
                    && request.resource.data.shortCode == shortCode
                    && shortCode.size() >= 8
                    && shortCode.size() <= 16;
      allow update: if request.auth != null
                    && (resource.data.ownerUserId == request.auth.uid || isConfiguredMasterEmail());
      allow delete: if request.auth != null
                    && (resource.data.ownerUserId == request.auth.uid || isConfiguredMasterEmail());
    }

    // Individual analytics events — public catalog visitors can write; owner can read
    match /catalog_analytics/{shortCode}/events/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['type', 'sessionId', 'ownerUserId', 'createdAt'])
                    && request.resource.data.type in ['visit', 'product_view', 'section_view', 'order_submit', 'time_on_page']
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() >= 6
                    && request.resource.data.sessionId.size() < 100
                    && request.resource.data.ownerUserId is string
                    && request.resource.data.ownerUserId.size() > 0
                    && shortCode.size() >= 8
                    && shortCode.size() <= 16;
      allow read: if request.auth != null
                  && (
                    get(/databases/$(database)/documents/catalog_analytics/$(shortCode)).data.ownerUserId == request.auth.uid
                    || isConfiguredMasterEmail()
                  );
      allow delete: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/catalog_analytics/$(shortCode)).data.ownerUserId == request.auth.uid
                      || isConfiguredMasterEmail()
                    );
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
